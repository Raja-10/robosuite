  <contact>
    <!-- These body pairs' collision meshes overlap at rest (mesh/mounting artifact,
         not a real physical interference): without excluding them, MuJoCo's contact
         solver perturbs the arm off qpos=0 even before the first env.step(), and the
         perturbation grows under any dynamics. Cross-checked against the same robot's
         non-colliding (visual-only) copy in another local checkout, which has no such
         drift. -->
    <exclude name="base_link_1" body1="base_link" body2="link1"/>
    <exclude name="link5_7" body1="link5" body2="link7"/>
  </contact>

