<mujoco model="nero_gripper">

  <compiler angle="radian"/>


  <asset>
    <mesh name="gripper_flange" file="meshes/piper_gripper/gripper_flange.stl"/>
    <mesh name="gripper_base"   file="meshes/piper_gripper/gripper_base.stl"/>
    <mesh name="gripper_link1"  file="meshes/piper_gripper/gripper_link1.stl"/>
    <mesh name="gripper_link2"  file="meshes/piper_gripper/gripper_link2.stl"/>

    <material name="robot_grey" rgba="0.6 0.6 0.6 1"/>
    <material name="white"      rgba="1 1 1 1"/>
    <material name="black"      rgba="0.25 0.25 0.25 1"/>
    <material name="off_white"  rgba="0.9 0.92 0.93 1"/>
  </asset>

  <actuator>
    <!-- gripper_joint1: prismatic, opens finger1 outward (0 → 0.05 m) -->
    <position name="gripper_finger_joint1"
              joint="gripper_joint1"
              kp="1000"
              ctrllimited="true" ctrlrange="0.0 0.05"
              forcelimited="true" forcerange="-10 10"/>

    <!-- gripper_joint2: prismatic, opens finger2 inward (-0.05 → 0 m) -->
    <position name="gripper_finger_joint2"
              joint="gripper_joint2"
              kp="1000"
              ctrllimited="true" ctrlrange="-0.05 0.0"
              forcelimited="true" forcerange="-10 10"/>
  </actuator>

  <worldbody>

    <!--
      gripper_flange_joint:
        pos="0.032 0 -0.0235"  rpy="-1.5708 0 -1.5708"
        parent: link7  (treat as world here for standalone model)
    -->
    <!-- The URDF flange transform is expressed in the original link7 frame.
         Nero7's MJCF arm frames are already converted, so this is the
         equivalent transform in the converted MJCF link7 frame. -->
    <body name="gripper_flange" pos="0.032 0 -0.0235" euler="1.5707963 1.5707963 0">
      <inertial pos="0.000253201 -0.000322696 -0.010082901"
                mass="0.04771096"
                fullinertia="3.614107e-05 1.7824164e-05 2.695944e-05
                             0 0 0"/>

      <!-- visual -->
      <geom name="gripper_flange_visual"
            type="mesh" mesh="gripper_flange"
            contype="0" conaffinity="0" group="1"
            material="robot_grey"/>
      <!-- collision -->
      <geom name="gripper_flange_collision"
            type="mesh" mesh="gripper_flange"
            contype="0" conaffinity="0" group="1"/>

      <!-- ft site at flange origin -->
      <site name="ft_frame" pos="0 0 0" size="0.01" rgba="1 0 0 1" type="sphere" group="1"/>

      <!--
        gripper_base_joint: fixed, converted MJCF pos="0 0 0.0055"
      -->
      <body name="gripper_base" pos="0 0 0.0055" euler="0 0 0">
        <inertial pos="-0.000183807162235591 8.05033155577911e-05 0.0321436689908876"
                  mass="0.45"
                  fullinertia="0.00092934 0.00071447 0.00039442
                               0.00000034 -0.00000738 0.00000005"/>

        <!-- visual -->
        <geom name="gripper_base_visual"
              type="mesh" mesh="gripper_base"
              contype="0" conaffinity="0" group="1"
              material="off_white"/>
        <!-- collision -->
        <geom name="gripper_base_collision"
              type="mesh" mesh="gripper_base"
              contype="1" conaffinity="1" group="0"/>

        <!--
          gripper_joint1: converted MJCF mounting transform
          axis xyz="0 0 1"  range: 0 → 0.05
        -->
        <body name="gripper_link1" pos="0 0.005 0.1358" euler="-1.5707963 0 3.1415926">
          <inertial pos="0.00065123185041968 -0.0491929869131989 0.00972258769184025"
                    mass="0.025"
                    fullinertia="0.00007371 0.00000781 0.00007470
                                 -0.00000113 0.00000021 -0.00001372"/>

          <joint name="gripper_joint1"
                 type="slide" axis="0 0 1"
                 range="0.0 0.05"
                 damping="100" armature="1.0" frictionloss="1.0"/>

          <!-- visual -->
          <geom name="gripper_link1_visual"
                type="mesh" mesh="gripper_link1"
                contype="0" conaffinity="0" group="1"
                material="robot_grey"/>
          <!-- collision -->
          <!-- The imported link mesh is visual-only for contact purposes.
               Grasp contact is handled by the convex finger pad below; using
               the non-convex mesh here can hook thin inserted pieces during
               vertical withdrawal. -->
          <geom name="gripper_link1_collision"
                type="mesh" mesh="gripper_link1"
                contype="0" conaffinity="0" group="0"
                solref="0.02 1" friction="1 0.005 0.0001" condim="4"/>

          <!-- finger 1 tip pad -->
          <body name="gripper_link1_tip" pos="0 -0.01 0">
            <inertial pos="0 0 0" mass="0.01" diaginertia="0.01 0.01 0.01"/>
            <geom name="finger1_pad_collision"
                  size="0.008 0.008 0.004" type="box"
                  group="0" contype="1" conaffinity="1"
                  solref="0.01 0.5" friction="2 0.05 0.0001"/>
          </body>
        </body>

        <!--
          gripper_joint2: converted MJCF mounting transform
          axis xyz="0 0 -1"  → in MuJoCo model as slide axis="0 0 1" with negated range
          range: -0.05 → 0
        -->
        <body name="gripper_link2" pos="0 -0.005 0.1358" euler="1.5707963 0 0">
          <inertial pos="0.00065123185041968 -0.0491929869131989 0.00972258769184025"
                    mass="0.025"
                    fullinertia="0.00007371 0.00000781 0.00007470
                                 -0.00000113 0.00000021 -0.00001372"/>

          <joint name="gripper_joint2"
                 type="slide" axis="0 0 -1"
                 range="-0.05 0.0"
                 damping="100" armature="1.0" frictionloss="1.0"/>

          <!-- visual -->
          <geom name="gripper_link2_visual"
                type="mesh" mesh="gripper_link2"
                contype="0" conaffinity="0" group="1"
                material="robot_grey"/>
          <!-- collision -->
          <!-- See gripper_link1_collision: the pad is the contact model. -->
          <geom name="gripper_link2_collision"
                type="mesh" mesh="gripper_link2"
                contype="0" conaffinity="0" group="0"
                solref="0.02 1" friction="1 0.005 0.0001" condim="4"/>

          <!-- finger 2 tip pad -->
          <body name="gripper_link2_tip" pos="0 -0.01 0">
            <inertial pos="0 0 0" mass="0.01" diaginertia="0.01 0.01 0.01"/>
            <geom name="finger2_pad_collision"
                  size="0.008 0.008 0.004" type="box"
                  group="0" contype="1" conaffinity="1"
                  solref="0.01 0.5" friction="2 0.05 0.0001"/>
          </body>
        </body>

        <!-- EEF frame at gripper centre (approx midpoint between fingers) -->
        <body name="eef" pos="0 0 0.1255">
          <site name="grip_site"
                pos="0 0 0" size="0.01" rgba="1 0 0 0.5" type="sphere" group="1"/>
          <site name="ee_x"
                pos="0.1 0 0" size="0.005 0.1" quat="0.707105 0 0.707108 0"
                rgba="1 0 0 0" type="cylinder" group="1"/>
          <site name="ee_y"
                pos="0 0.1 0" size="0.005 0.1" quat="0.707105 0.707108 0 0"
                rgba="0 1 0 0" type="cylinder" group="1"/>
          <site name="ee_z"
                pos="0 0 0.1" size="0.005 0.1" quat="1 0 0 0"
                rgba="0 0 1 0" type="cylinder" group="1"/>
          <site name="grip_site_cylinder"
                pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1"/>
        </body>

      </body>
    </body>

  </worldbody>

  <sensor>
    <force  name="force_ee"  site="ft_frame"/>
    <torque name="torque_ee" site="ft_frame"/>
  </sensor>

</mujoco>
